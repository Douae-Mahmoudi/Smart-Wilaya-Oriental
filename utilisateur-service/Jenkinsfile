pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'douaemahmoudi/utilisateur-service'
        SONAR_PROJECT_KEY = 'Douae-Mahmoudi_wilaya-project'
        SONAR_ORGANIZATION = 'douae-mahmoudi'
        NVD_API_KEY = credentials('nvd-api-key')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('utilisateur-service') {
                    sh 'mvn clean compile -B'
                }
            }
        }

        stage('Tests') {
            steps {
                dir('utilisateur-service') {
                    sh 'mvn test -B'
                }
            }
        }

        // Diagnostic réseau avec la clé API pour confirmer que l'accès NVD fonctionne depuis Jenkins
        stage('Test NVD Network with Key') {
            steps {
                sh '''
                    echo "Test de l'API NVD avec la clé (statut HTTP) :"
                    curl -s -o /dev/null -w "Status: %{http_code}\\n" \
                        -H "apiKey: $NVD_API_KEY" \
                        "https://services.nvd.nist.gov/rest/json/cves/2.0?resultsPerPage=1"
                '''
            }
        }

        stage('OWASP Dependency-Check') {
            steps {
                dir('utilisateur-service') {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                        sh '''
                            # Nettoyer la clé (retirer les sauts de ligne)
                            echo -n "$NVD_API_KEY" | tr -d '\\n\\r' > /tmp/nvd.key
                            # Lancer le scan avec la version 10.0.1 du plugin (vérifier pom.xml)
                            mvn org.owasp:dependency-check-maven:check -B \
                                -DnvdApiKey=$(cat /tmp/nvd.key) \
                                -DnvdApiDelay=10000
                            rm -f /tmp/nvd.key
                        '''
                    }
                }
            }
            post {
                always {
                    script {
                        // Archiver le rapport s'il existe
                        if (fileExists('utilisateur-service/target/dependency-check-report.html')) {
                            archiveArtifacts artifacts: 'utilisateur-service/target/dependency-check-report.*',
                                              allowEmptyArchive: true
                        } else {
                            echo "Rapport OWASP non trouvé (peut-être l'étape a échoué trop tôt)."
                        }
                    }
                }
            }
        }

        stage('SonarCloud Analysis') {
            steps {
                dir('utilisateur-service') {
                    withSonarQubeEnv('SonarCloud') {
                        sh """
                            mvn sonar:sonar \
                            -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                            -Dsonar.organization=${SONAR_ORGANIZATION} \
                            -Dsonar.host.url=https://sonarcloud.io
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    try {
                        timeout(time: 3, unit: 'MINUTES') {
                            def qg = waitForQualityGate abortPipeline: false
                            echo "Quality Gate status: ${qg.status}"
                        }
                    } catch (Exception e) {
                        echo "Quality Gate check ignorée (webhook non configuré) : ${e.message}"
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('utilisateur-service') {
                    // On s'assure que le socket est accessible (si le chmod a été fait, ça passe)
                    sh "docker build -t ${DOCKER_IMAGE}:latest ."
                }
            }
        }

        stage('Trivy Scan') {
            steps {
                script {
                    // Limiter le temps pour éviter les crashes longs
                    try {
                        timeout(time: 15, unit: 'MINUTES') {
                            sh """
                                docker run --rm \
                                    -v /var/run/docker.sock:/var/run/docker.sock \
                                    aquasec/trivy image \
                                    --severity HIGH,CRITICAL \
                                    --exit-code 1 \
                                    --no-progress \
                                    --parallel 2 \
                                    --cache-dir /tmp/trivy-cache \
                                    ${DOCKER_IMAGE}:latest
                            """
                        }
                    } catch (Exception e) {
                        // Si Trivy échoue (crash ou vulnérabilités), on marque UNSTABLE mais on continue
                        echo "Trivy scan a échoué : ${e.message}"
                        currentBuild.result = 'UNSTABLE'
                    }
                }
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh """
                        echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin
                        docker push ${DOCKER_IMAGE}:latest
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline utilisateur-service terminée avec succès (build + tests + sécurité OK)"
        }
        unstable {
            echo "Pipeline terminé avec des avertissements (certaines vérifications de sécurité ont échoué)"
        }
        failure {
            echo "Pipeline utilisateur-service a échoué"
        }
    }
}
pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'douaemahmoudi/utilisateur-service'
        SONAR_PROJECT_KEY = 'Douae-Mahmoudi_wilaya-project'
        SONAR_ORGANIZATION = 'douae-mahmoudi'
        NVD_API_KEY = credentials('nvd-api-key')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('utilisateur-service') {
                    sh 'mvn clean compile -B'
                }
            }
        }

        stage('Tests') {
            steps {
                dir('utilisateur-service') {
                    sh 'mvn test -B'
                }
            }
        }

        // ---- STAGE TEMPORAIRE DE DEBUG ----
        // A retirer une fois le probleme de cle NVD resolu.
        // Affiche uniquement la LONGUEUR de la cle (jamais la valeur),
        // pour verifier qu'elle correspond bien aux 36 caracteres attendus.
        stage('Debug NVD Key Length') {
            steps {
                sh 'echo "Longueur de la cle NVD_API_KEY : ${#NVD_API_KEY} caracteres"'
            }
        }

        stage('OWASP Dependency-Check') {
            steps {
                dir('utilisateur-service') {
                    // Utilise le plugin ajouté dans le pom.xml (voir section pom.xml).
                    // failBuildOnCVSS=7 dans le pom fait echouer ce stage si une
                    // vulnerabilite HIGH/CRITICAL est detectee dans les dependances.
                    sh 'mvn org.owasp:dependency-check-maven:check -B'
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'utilisateur-service/target/dependency-check-report.*',
                                      allowEmptyArchive: true
                }
            }
        }

        stage('SonarCloud Analysis') {
            steps {
                dir('utilisateur-service') {
                    withSonarQubeEnv('SonarCloud') {
                        sh """
                            mvn sonar:sonar \
                            -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                            -Dsonar.organization=${SONAR_ORGANIZATION} \
                            -Dsonar.host.url=https://sonarcloud.io
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    try {
                        timeout(time: 3, unit: 'MINUTES') {
                            def qg = waitForQualityGate abortPipeline: false
                            echo "Quality Gate status: ${qg.status}"
                        }
                    } catch (Exception e) {
                        echo "Quality Gate check ignore (webhook non configure) : ${e.message}"
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('utilisateur-service') {
                    sh "docker build -t ${DOCKER_IMAGE}:latest ."
                }
            }
        }

        stage('Trivy Scan') {
            steps {
                sh """
                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                        aquasec/trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        --no-progress \
                        ${DOCKER_IMAGE}:latest
                """
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                    // retry(3) relance jusqu'a 3 fois en cas d'echec reseau
                    // transitoire (ex: connexion coupee pendant l'upload d'une
                    // grosse couche Docker), sans faire echouer tout de suite
                    // la pipeline pour un simple hoquet reseau.
                    retry(3) {
                        sh "docker push ${DOCKER_IMAGE}:latest"
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline utilisateur-service terminee avec succes (build + tests + securite OK)"
        }
        failure {
            echo "Pipeline utilisateur-service a echoue"
        }
    }
}

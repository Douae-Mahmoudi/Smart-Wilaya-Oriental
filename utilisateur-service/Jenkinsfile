pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'douaemahmoudi/utilisateur-service'
        SONAR_PROJECT_KEY = 'Douae-Mahmoudi_wilaya-project'
        SONAR_ORGANIZATION = 'douae-mahmoudi'
        NVD_API_KEY = credentials('nvd-api-key')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('utilisateur-service') {
                    sh 'mvn clean compile -B'
                }
            }
        }

        stage('Tests') {
            steps {
                dir('utilisateur-service') {
                    sh 'mvn test -B'
                }
            }
        }

        // Étape de diagnostic réseau (optionnelle, peut être supprimée après résolution)
        stage('Test NVD Network') {
            steps {
                sh 'curl -s -o /dev/null -w "%{http_code}" https://services.nvd.nist.gov/rest/json/cves/2.0?resultsPerPage=1 || echo "Échec réseau"'
            }
        }

        stage('OWASP Dependency-Check') {
            steps {
                dir('utilisateur-service') {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                        sh '''
                            # Écrire la clé dans un fichier temporaire pour éviter les problèmes d'interpolation
                            echo "$NVD_API_KEY" > /tmp/nvd.key
                            # Lancer le scan avec la clé lue depuis le fichier
                            mvn org.owasp:dependency-check-maven:check -B \
                                -DnvdApiKey=$(cat /tmp/nvd.key) \
                                -DnvdApiDelay=5000 \
                                # Décommenter les lignes suivantes si vous utilisez un proxy
                                # -Dhttp.proxyHost=proxy.example.com \
                                # -Dhttp.proxyPort=8080 \
                                # -Dhttps.proxyHost=proxy.example.com \
                                # -Dhttps.proxyPort=8080
                            rm -f /tmp/nvd.key
                        '''
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'utilisateur-service/target/dependency-check-report.*',
                                      allowEmptyArchive: true
                }
            }
        }

        stage('SonarCloud Analysis') {
            steps {
                dir('utilisateur-service') {
                    withSonarQubeEnv('SonarCloud') {
                        sh """
                            mvn sonar:sonar \
                            -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                            -Dsonar.organization=${SONAR_ORGANIZATION} \
                            -Dsonar.host.url=https://sonarcloud.io
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    try {
                        timeout(time: 3, unit: 'MINUTES') {
                            def qg = waitForQualityGate abortPipeline: false
                            echo "Quality Gate status: ${qg.status}"
                        }
                    } catch (Exception e) {
                        echo "Quality Gate check ignore (webhook non configure) : ${e.message}"
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('utilisateur-service') {
                    sh "docker build -t ${DOCKER_IMAGE}:latest ."
                }
            }
        }

        stage('Trivy Scan') {
            steps {
                sh """
                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                        aquasec/trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        --no-progress \
                        ${DOCKER_IMAGE}:latest
                """
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh """
                        echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin
                        docker push ${DOCKER_IMAGE}:latest
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline utilisateur-service terminee avec succes (build + tests + securite OK)"
        }
        unstable {
            echo "Pipeline terminé avec des avertissements (OWASP échoué mais continue)"
        }
        failure {
            echo "Pipeline utilisateur-service a echoue"
        }
    }
}